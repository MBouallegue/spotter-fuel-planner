# Copy to .env and adjust. Every variable is optional; the defaults suit local development.

# --- Django ---------------------------------------------------------------
DJANGO_SECRET_KEY=change-me
# 1 serves the admin's static files under runserver; keep 0 anywhere public.
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Outbound HTTP --------------------------------------------------------
# Nominatim and OSRM require an identifying User-Agent with a contact URL or email.
HTTP_USER_AGENT=spotter-fuel-planner/1.0 (+https://github.com/MBouallegue/spotter-fuel-planner)
# Geocoder for free-text start/finish (street addresses, ZIP codes). "City, ST" never uses it.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_TIMEOUT_SECONDS=5
