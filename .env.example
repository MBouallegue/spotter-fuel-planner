# Copy to .env and adjust. Every variable is optional; the defaults suit local development.

# --- Django ---------------------------------------------------------------
DJANGO_SECRET_KEY=change-me
# 1 serves the admin's static files under runserver; keep 0 anywhere public.
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Seconds a database connection is reused across requests (0 = a new one per request).
DB_CONN_MAX_AGE=600

# --- Outbound HTTP --------------------------------------------------------
# Nominatim and OSRM require an identifying User-Agent with a contact URL or email.
HTTP_USER_AGENT=spotter-fuel-planner/1.0 (+https://github.com/MBouallegue/spotter-fuel-planner)
# Geocoder for free-text start/finish (street addresses, ZIP codes). "City, ST" never uses it.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_TIMEOUT_SECONDS=5

# --- Routing --------------------------------------------------------------
# Providers are tried in this order; a failing one hands over to the next.
ROUTING_PROVIDERS=osrm,ors
ROUTING_CONNECT_TIMEOUT_SECONDS=3
ROUTING_READ_TIMEOUT_SECONDS=15
# A provider that fails this many times in a row is skipped for BREAKER_RESET_SECONDS.
BREAKER_FAILURE_THRESHOLD=3
BREAKER_RESET_SECONDS=60
# The public OSRM demo server: free and keyless, at most 1 request per second, no SLA.
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_MIN_INTERVAL_SECONDS=1.0
# openrouteservice, the fallback: leave the key empty to turn it off. A free key
# (openrouteservice.org/dev) allows 2,000 routes a day, 40 a minute, up to 6,000 km.
ORS_API_KEY=
ORS_BASE_URL=https://api.openrouteservice.org
# driving-car, or driving-hgv to route as a heavy goods vehicle.
ORS_PROFILE=driving-car

# --- Inbound rate limit ---------------------------------------------------
# Requests per client IP; over it, the API answers 429 with Retry-After.
API_THROTTLE_RATE=60/min

# --- Logging --------------------------------------------------------------
# INFO logs one line per outbound call (service, HTTP status, duration).
LOG_LEVEL=INFO
